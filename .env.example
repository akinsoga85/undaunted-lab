# Postgres connection string from Neon (Vercel → Storage → Neon adds this for you).
# Leave unset locally to use the built-in embedded database in ./.data
DATABASE_URL=

# Who can sign in to /admin (comma-separated)
ADMIN_EMAILS=opeyemi@undauntedlab.com

# Email (https://resend.com): sign-in links and new-message alerts
RESEND_API_KEY=
MAIL_FROM=Undaunted Lab <hello@undauntedlab.com>
# Where message alerts go (defaults to ADMIN_EMAILS)
CONTACT_TO=

# Public address, used in sign-in links
SITE_URL=https://undauntedlab.com

# Any long random string; makes visitor counts unlinkable across days
ANALYTICS_SALT=

# Local only: print sign-in links in the terminal when no email provider is set
# AUTH_DEV_LINKS=1
